   "type": "array"
  },
  "vat_ids": {
   "items": {
    "type": "string"
   },
   "maxItems": 10,
   "title": "Vat Ids",
   "type": "array"
  },
  "legal_mentions": {
   "description": "Imprint, company register and withdrawal-right text.",
   "items": {
    "type": "string"
   },
   "maxItems": 50,
   "title": "Legal Mentions",
   "type": "array"
  },
  "policy_links": {
   "additionalProperties": {
    "type": "string"
   },
   "description": "Kind (refund, terms, privacy, contact, imprint, shipping) to URL.",
   "title": "Policy Links",
   "type": "object"
  },
  "image_urls": {
   "items": {
    "type": "string"
   },
   "maxItems": 50,
   "title": "Image Urls",
   "type": "array"
  }
 },
 "title": "PageFacts",
 "type": "object"
}
