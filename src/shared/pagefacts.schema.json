    "type": "string"
   },
   "maxItems": 100,
   "title": "Variations",
   "type": "array"
  },
  "json_ld": {
   "description": "Product JSON-LD.",
   "items": {
    "additionalProperties": true,
    "type": "object"
   },
   "maxItems": 20,
   "title": "Json Ld",
   "type": "array"
  },
  "script_srcs": {
   "items": {
    "type": "string"
   },
   "maxItems": 300,
   "title": "Script Srcs",
   "type": "array"
  },
  "meta": {
   "additionalProperties": {
    "type": "string"
   },
   "title": "Meta",
   "type": "object"
  },
  "hidden_text": {
   "items": {
    "type": "string"
   },
   "maxItems": 100,
   "title": "Hidden Text",
   "type": "array"
  },
  "checkboxes": {
   "items": {
    "$ref": "#/$defs/Checkbox"
   },
   "maxItems": 100,
   "title": "Checkboxes",
   "type": "array"
  },
  "timers": {
   "description": "Countdown elements or scripts.",
   "items": {
    "type": "string"
   },
   "maxItems": 50,
   "title": "Timers",
   "type": "array"
  },
  "fee_mentions": {
   "items": {
    "type": "string"
   },
   "maxItems": 50,
