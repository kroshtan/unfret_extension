{
  "name": "unfret-extension",
  "version": "0.12.0",
  "minBackendVersion": "0.11.2",
  "description": "Spot junk, dropshipping and scams on product pages before you buy.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "smoke": "node scripts/build.mjs && vitest run --config vitest.smoke.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/chrome": "0.3.7",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.6",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "jsqr": "1.4.0",
    "playwright": "1.65.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "web-ext": "10.8.0"
  },
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  }
}
